GITHUB_APP_ID=
# PEM contents, with newlines either real or written as \n. Alternatively set GITHUB_PRIVATE_KEY_FILE to a mounted path.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
# Required in X-Proxy-Secret on every request but the webhook; have the reverse proxy add it. Unset, nothing is checked.
# PROXY_SECRET=

REPOS_CONFIG=config/repos.yaml
DATA_DIR=/data
# Trusted git mirrors, the only clones that talk to GitHub with credentials. Defaults to <DATA_DIR>/mirrors.
# MIRRORS_DIR=/mirrors
# Host of the runner container that agent tools run in over SSH. Unset, they run unsandboxed in this process.
# RUNNER_HOST=runner
PORT=3000
# Public base URL (no trailing slash needed). When set, every status comment links to its run page at <PUBLIC_URL>/runs/<repo>/<issue>.
# PUBLIC_URL=https://factory.example.com
# Pipelines that run at once across all repos; the rest wait as "queued".
MAX_CONCURRENT=3

# Local dev only: use the scripted faux model instead of OpenRouter.
# MODEL=faux
# Test only: exit at a phase boundary.
# CRASH_AT=
