{
  "name": "mike-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:mock": "tsx watch src/dev/mock.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && pnpm -C web typecheck",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@hono/node-server": "2.1.5",
    "@octokit/app": "16.1.4",
    "@octokit/webhooks": "14.2.0",
    "hono": "4.13.13",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0"
}
